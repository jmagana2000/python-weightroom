    "id": "sql-novice-01-active-employees",
    "title": "Active Employees by Salary",
    "level": "sql-novice",
    "language": "sql",
    "cluster": "SELECT & Filtering",
    "topics": [
      "select",
      "where",
      "order-by"
    ],
    "prompt": "Table `employees(id, name, dept, salary, active)` \u2014 `active` is 1 or 0.\n\nWrite a query that returns the `name` and `salary` of every active employee, ordered by `salary` from highest to lowest.",
    "hint": "WHERE active = 1, then ORDER BY salary DESC.",
    "schema_sql": "CREATE TABLE employees (id INTEGER PRIMARY KEY, name TEXT, dept TEXT, salary INTEGER, active INTEGER);",
    "starter_code": "-- write your query here\n",
    "tests": [
      {
        "seed_sql": "INSERT INTO employees VALUES (1,'Alice','Eng',90000,1),(2,'Bob','Eng',70000,0),(3,'Cara','Sales',85000,1);",
        "expected": [
          [
            "Alice",
            90000
          ],
          [
            "Cara",
            85000
          ]
        ],
        "order_sensitive": true
      },
      {
        "seed_sql": "INSERT INTO employees VALUES (1,'Dan','Ops',50000,1),(2,'Eve','Ops',60000,1),(3,'Fay','Ops',40000,0);",
        "expected": [
          [
            "Eve",
            60000
          ],
          [
            "Dan",
            50000
          ]
        ],
        "order_sensitive": true
      },
      {
        "seed_sql": "INSERT INTO employees VALUES (1,'Gus','X',30000,0);",
        "expected": [],
        "order_sensitive": true
      }
    ]
  },
