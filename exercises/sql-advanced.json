[
  {
    "id": "sql-advanced-01-running-total",
    "title": "Running Total of Transactions",
    "level": "sql-advanced",
    "language": "sql",
    "cluster": "Running Totals & Moving Averages",
    "topics": [
      "window-functions",
      "running-total"
    ],
    "prompt": "Table `transactions(id, txn_date, amount)`.\n\nReturn each `txn_date` and `amount`, plus a third column `running_total` \u2014 the cumulative sum of `amount` ordered by `txn_date`. Order your results by `txn_date`.",
    "hint": "SUM(amount) OVER (ORDER BY txn_date).",
    "schema_sql": "CREATE TABLE transactions (id INTEGER PRIMARY KEY, txn_date TEXT, amount INTEGER);",
    "starter_code": "-- write your query here\n",
    "tests": [
      {
        "seed_sql": "INSERT INTO transactions (txn_date, amount) VALUES ('2024-01-01',100),('2024-01-02',50),('2024-01-03',25);",
        "expected": [
          [
            "2024-01-01",
            100,
            100
          ],
          [
            "2024-01-02",
            50,
            150
          ],
          [
            "2024-01-03",
            25,
            175
          ]
        ],
        "order_sensitive": true
      },
      {
        "seed_sql": "INSERT INTO transactions (txn_date, amount) VALUES ('2024-02-01',10),('2024-02-02',-5),('2024-02-03',20);",
        "expected": [
          [
            "2024-02-01",
            10,
            10
          ],
          [
            "2024-02-02",
            -5,
            5
          ],
          [
            "2024-02-03",
            20,
            25
          ]
        ],
        "order_sensitive": true
      },
      {
        "seed_sql": "INSERT INTO transactions (txn_date, amount) VALUES ('2024-03-01',7);",
        "expected": [
          [
            "2024-03-01",
            7,
            7
          ]
        ],
        "order_sensitive": true
      }
    ]
  },
  {
    "id": "sql-advanced-02-consecutive-logins",
    "title": "Longest Login Streak",
    "level": "sql-advanced",
    "language": "sql",
    "cluster": "Gaps & Islands",
    "topics": [
      "gaps-and-islands",
      "window-functions"
    ],
    "prompt": "Table `logins(user_id, login_date)` \u2014 one row per day a user logged in, dates as 'YYYY-MM-DD', no duplicates per user/day.\n\nFor each `user_id`, find their longest streak of consecutive-day logins. Return `user_id` and `streak_length`, one row per user.",
    "hint": "Classic gaps-and-islands: julianday(login_date) - ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY login_date) is constant within a consecutive run.",
    "schema_sql": "CREATE TABLE logins (user_id INTEGER, login_date TEXT);",
    "starter_code": "-- write your query here\n",
    "tests": [
      {
        "seed_sql": "INSERT INTO logins VALUES (1,'2024-01-01'),(1,'2024-01-02'),(1,'2024-01-03'),(1,'2024-01-05'),(2,'2024-01-10'),(2,'2024-01-11');",
        "expected": [
          [
            1,
            3
          ],
          [
            2,
            2
          ]
        ]
      },
      {
        "seed_sql": "INSERT INTO logins VALUES (1,'2024-02-01'),(1,'2024-02-03'),(1,'2024-02-05');",
        "expected": [
          [
            1,
            1
          ]
        ]
      },
      {
        "seed_sql": "INSERT INTO logins VALUES (3,'2024-03-01'),(3,'2024-03-02'),(3,'2024-03-03'),(3,'2024-03-04');",
        "expected": [
          [
            3,
            4
          ]
        ]
      }
    ]
  },
  {
    "id": "sql-advanced-03-employee-hierarchy",
    "title": "Org Chart Depth",
    "level": "sql-advanced",
    "language": "sql",
    "cluster": "Recursive CTEs & Hierarchies",
    "topics": [
      "recursive-cte",
      "hierarchy"
    ],
    "prompt": "Table `employees(id, name, manager_id)` \u2014 `manager_id` is NULL for the top of the org chart.\n\nReturn each employee's `name` and their `depth` in the hierarchy (0 for someone with no manager, 1 for their direct reports, and so on).",
    "hint": "WITH RECURSIVE, starting from manager_id IS NULL at depth 0.",
    "schema_sql": "CREATE TABLE employees (id INTEGER PRIMARY KEY, name TEXT, manager_id INTEGER);",
    "starter_code": "-- write your query here\n",
    "tests": [
      {
        "seed_sql": "INSERT INTO employees VALUES (1,'CEO',NULL),(2,'VP',1),(3,'Eng',2);",
        "expected": [
          [
            "CEO",
            0
          ],
          [
            "VP",
            1
          ],
          [
            "Eng",
            2
          ]
        ]
      },
      {
        "seed_sql": "INSERT INTO employees VALUES (1,'Root',NULL),(2,'A',1),(3,'B',1),(4,'C',2);",
        "expected": [
          [
            "Root",
            0
          ],
          [
            "A",
            1
          ],
          [
            "B",
            1
          ],
          [
            "C",
            2
          ]
        ]
      },
      {
        "seed_sql": "INSERT INTO employees VALUES (1,'Solo',NULL);",
        "expected": [
          [
            "Solo",
            0
          ]
        ]
      }
    ]
  }
]
